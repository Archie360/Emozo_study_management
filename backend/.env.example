DATABASE_URL="postgresql://postgres:postgres@localhost:5432/study_task_app?schema=public"
# When using Supabase: DATABASE_URL is the Transaction Pooler (port 6543, ?pgbouncer=true).
# DIRECT_URL should be the Session Pooler (port 5432, same pooler host, no pgbouncer param) —
# NOT the "Direct connection" (db.<ref>.supabase.co) host, which is IPv6-only and unreachable
# from most hosts' build environments (e.g. Render), causing a P1001 error during migrations.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/study_task_app?schema=public"
PORT=4000
JWT_SECRET="change-me-in-production"
NODE_ENV=development
# Set in production to restrict CORS to your deployed frontend, e.g. https://your-app.vercel.app
FRONTEND_URL=
